# Copy to .env (root) or per-service .env files. Never commit real secrets.
# Mongo
MONGO_URI=mongodb://localhost:27017
MONGO_DB=vehicle_sharing_dev

# Backend
BACKEND_PORT=8000
JWT_SECRET=change-me-in-dev-only-min-32-chars
JWT_EXPIRE_MINUTES=10080
CORS_ORIGINS=http://localhost:3000

# Module 25 — runtime environment. "production" turns on the startup guard in
# app/main.py, which refuses to boot on the dev JWT secret above, on an empty
# CORS_ORIGINS, or on a plain-http CORS origin. Leave it as "development"
# locally, or every dev run will fail on the shipped secret.
APP_ENV=development
GIT_SHA=dev
# docker-compose.prod.yml only (Mongo credentials; never commit real values)
MONGO_ROOT_USER=change-me
MONGO_ROOT_PASSWORD=change-me-too

# Frontend (NEXT_PUBLIC_* is exposed to browser)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_MAP_STYLE=dark
NEXT_PUBLIC_OSRM_URL=https://router.project-osrm.org
NEXT_PUBLIC_NOMINATIM_URL=https://nominatim.openstreetmap.org

# Routing provider switch (Module 7 will honour this; default OSRM public demo)
ROUTING_PROVIDER=osrm
GEOCODER_PROVIDER=nominatim

# Cost engine (Module 12) — per-fuel unit prices in INR
FUEL_PRICE_PETROL=104.5
FUEL_PRICE_DIESEL=95.0
FUEL_PRICE_CNG=89.0
FUEL_PRICE_EV=12.0
FUEL_PRICE_HYBRID=95.0
DEFAULT_MILEAGE_KMPL=15.0
DEFAULT_COST_POLICY=split_equal

# Advance booking + recurring (Modules 14-15)
ADVANCE_MAX_DAYS=30
ADVANCE_MIN_NOTICE_MIN=60
RECURRING_HORIZON_DAYS=21
RECURRING_MAX_DAYS=90
