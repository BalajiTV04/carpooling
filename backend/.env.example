# MongoDB URI
# Local dev:  mongodb://localhost:27017
# Docker:     mongodb://mongo:27017
# MongoDB Atlas (production): mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority
# Set this in your hosting dashboard (Render/Vercel), NOT in this file.
MONGO_URI=mongodb://localhost:27017
MONGO_DB=vehicle_sharing_dev
JWT_SECRET=change-me-in-dev-only-min-32-chars
JWT_EXPIRE_MINUTES=10080
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://voltride-app2.vercel.app
CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1|.*\.vercel\.app)(:\d+)?$
ROUTING_PROVIDER=osrm
GEOCODER_PROVIDER=nominatim
OSRM_URL=https://router.project-osrm.org
NOMINATIM_URL=https://nominatim.openstreetmap.org

# Default country code for phone normalization (e.g. +91 for India).
DEFAULT_COUNTRY_CODE=+91

# Cost engine (Module 12) — per-fuel unit prices in INR
FUEL_PRICE_PETROL=104.5
FUEL_PRICE_DIESEL=95.0
FUEL_PRICE_CNG=89.0
FUEL_PRICE_EV=12.0
FUEL_PRICE_HYBRID=95.0
DEFAULT_MILEAGE_KMPL=15.0
DEFAULT_COST_POLICY=split_equal

# Minimum-Detour Pickup optimisation
PICKUP_SNAP_KM=0.5
MAX_PICKUP_DISTANCE_KM=3
DEST_TOLERANCE_KM=2
MAX_DETOUR_KM=3
MAX_EXTRA_MIN=10
FUEL_PRICE_PER_LITRE=100
COST_SPLIT_POLICY=EQUAL_SPLIT
INCLUDE_DETOUR_COST=false
ROUND_MODE=CEIL
LOCK_FUEL_PRICE_AFTER_ACCEPT=true

# Advance booking + recurring (Modules 14-15)
ADVANCE_MAX_DAYS=30
ADVANCE_MIN_NOTICE_MIN=60
RECURRING_HORIZON_DAYS=21
RECURRING_MAX_DAYS=90
