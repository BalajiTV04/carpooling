NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_MAP_STYLE=dark
NEXT_PUBLIC_OSRM_URL=https://router.project-osrm.org
NEXT_PUBLIC_NOMINATIM_URL=https://nominatim.openstreetmap.org
# Module 20: no separate WS variable — lib/live.ts derives the socket origin by
# swapping the API scheme (http->ws, https->wss), so a deploy only moves the API
# host and /stream follows. Reverse proxies must forward the Upgrade header.
