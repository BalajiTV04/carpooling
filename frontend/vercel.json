{
  "version": 2,
  "buildCommand": "cd frontend && npm ci && npm run build",
  "outputDirectory": "frontend/.next",
  "framework": "nextjs",
  "regions": ["iad1"],
  "env": {
    "NEXT_PUBLIC_API_URL": "@voltride-api-url",
    "NEXT_PUBLIC_MAP_PROVIDER": "@voltride-map-provider",
    "NEXT_PUBLIC_OSRM_URL": "@voltride-osrm-url",
    "NEXT_PUBLIC_NOMINATIM_URL": "@voltride-nominatim-url"
  }
}